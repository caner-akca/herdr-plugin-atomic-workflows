# Telegram cockpit secrets. Copy this file to the plugin CONFIG directory
# (not the plugin source directory):
#
#   cp .env.example "$(herdr plugin config-dir atomic.workflows)/.env"
#
# The startup hook skips the Telegram daemon while no .env exists there.

# Bot token from @BotFather (keep this secret; never commit it).
TELEGRAM_BOT_TOKEN=

# Chat that receives push updates about runs (usually your own user id).
# Message the bot once before configuring users and it replies with your id.
TELEGRAM_COCKPIT_CHAT_ID=

# Optional: maintainer chat for /handoff digests and decision buttons.
# Leave unset to disable the maintainer handoff feature.
TELEGRAM_MAINTAINER_CHAT_ID=
